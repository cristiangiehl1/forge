{
  "name": "forge",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@11.24.0",
  "engines": {
    "node": "^24.21.0"
  },
  "scripts": {
    "dev": "pnpm --filter @forge/web run dev",
    "build": "pnpm -r --if-present run build",
    "typecheck": "pnpm -r --if-present run typecheck",
    "test": "pnpm -r --if-present run test",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "format:check": "biome format .",
    "lint:ci": "biome ci .",
    "e2e": "pnpm --filter @forge/e2e run e2e",
    "e2e:ui": "pnpm --filter @forge/e2e run e2e:ui",
    "e2e:tour": "pnpm --filter @forge/e2e run e2e:tour",
    "e2e:report": "pnpm --filter @forge/e2e run e2e:report"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.5.15",
    "typescript": "catalog:"
  }
}
